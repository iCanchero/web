# Firebase client configuration
ICAN_FIREBASE_API_KEY=your-firebase-api-key
ICAN_FIREBASE_PROJECT_ID=your-firebase-project-id
ICAN_FIREBASE_APP_ID=your-firebase-app-id

# Player API gateway
ICAN_API_URL=https://api.example.com

# Absolute public origin used for canonical and social preview URLs
ICAN_SITE_URL=https://app-dev.icanchero.com

# Server runtime app associations (not ICAN_ browser variables)
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.icanchero.app
# Optional full application-identifier override if the App ID prefix differs
IOS_APP_ID=
ANDROID_PACKAGE_NAME=com.icanchero.app
# Comma-separated SHA-256 signing certificate fingerprints
ANDROID_SHA256_FINGERPRINTS=
